# Normalize line endings: LF in the repository for everything textual.
* text=auto

# Scripts that must keep LF even on Windows checkouts.
*.sh text eol=lf
gradlew text eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (never touch).
*.jar binary
*.apk binary
*.png binary
*.ico binary
